<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:LinguaPath.Mobile.Localization"
       xmlns:pages="clr-namespace:LinguaPath.Mobile.Pages"
       x:Class="LinguaPath.Mobile.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarHasShadow="False"
       Title="LinguaPath">

    <!-- Start-up and sign-in roots: no tab bar, no back stack between them. -->
    <ShellContent Route="splash" ContentTemplate="{DataTemplate pages:SplashPage}" Shell.NavBarIsVisible="False" />
    <ShellContent Route="welcome" ContentTemplate="{DataTemplate pages:WelcomePage}" Shell.NavBarIsVisible="False" />
    <ShellContent Route="login" ContentTemplate="{DataTemplate pages:LoginPage}" Title="{l:Tr SignIn}" />

    <!-- Main app (SRS 2.3): Home, Learn, Practice, Translate, Profile -->
    <TabBar Route="main">
        <Tab Title="{l:Tr Home}" Route="home" Icon="tab_home.png">
            <ShellContent ContentTemplate="{DataTemplate pages:HomePage}" />
        </Tab>
        <Tab Title="{l:Tr Learn}" Route="learn" Icon="tab_learn.png">
            <ShellContent ContentTemplate="{DataTemplate pages:RoadmapPage}" />
        </Tab>
        <Tab Title="{l:Tr Practice}" Route="practice" Icon="tab_practice.png">
            <ShellContent ContentTemplate="{DataTemplate pages:PracticePage}" />
        </Tab>
        <Tab Title="{l:Tr Translate}" Route="translate" Icon="tab_translate.png">
            <ShellContent ContentTemplate="{DataTemplate pages:TranslatePage}" />
        </Tab>
        <Tab Title="{l:Tr Profile}" Route="profile" Icon="tab_profile.png">
            <ShellContent ContentTemplate="{DataTemplate pages:ProfilePage}" />
        </Tab>
    </TabBar>
</Shell>
