<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:l="clr-namespace:LinguaPath.Mobile.Localization"
                xmlns:pages="clr-namespace:LinguaPath.Mobile.Pages"
                xmlns:vm="clr-namespace:LinguaPath.Mobile.Core.ViewModels;assembly=LinguaPath.Mobile.Core"
                xmlns:learning="clr-namespace:LinguaPath.Shared.Contracts.Learning;assembly=LinguaPath.Shared"
                x:Class="LinguaPath.Mobile.Pages.RoadmapPage"
                x:DataType="vm:RoadmapViewModel"
                Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Style="{StaticResource HeaderBand}" Padding="20,44,20,22">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Style="{StaticResource IconTileOnHero}">
                        <Path Style="{StaticResource IconOnHero}" Data="{StaticResource IconBook}" />
                    </Border>
                    <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource HeroTitle}" VerticalOptions="Center" />
                    <Button Grid.Column="2" Text="{l:Tr Plan}" Style="{StaticResource HeroChipButton}" VerticalOptions="Center"
                            Command="{Binding OpenSettingsCommand}" IsVisible="{Binding HasCourse}" />
                </Grid>
                <Label Text="{Binding Summary}" Style="{StaticResource HeroText}" />
                <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                </Border>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="White" />
            </VerticalStackLayout>
        </Border>

        <!-- No course yet -->
        <VerticalStackLayout Grid.Row="1" Padding="32" Spacing="14" VerticalOptions="Center" IsVisible="{Binding NoCourse}">
            <Border Style="{StaticResource IconTile}" WidthRequest="72" HeightRequest="72" StrokeShape="RoundRectangle 24" HorizontalOptions="Center">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconTarget}" WidthRequest="34" HeightRequest="34" />
            </Border>
            <Label Text="{l:Tr NoRoadmapYet}" Style="{StaticResource Headline}" HorizontalOptions="Center" />
            <Label Text="{l:Tr ChooseALanguageAndWeLl}" Style="{StaticResource Subtitle}" HorizontalTextAlignment="Center" />
            <Button Text="{l:Tr ChooseALanguage}" Style="{StaticResource GradientButton}" Command="{Binding StartCourseCommand}" />
        </VerticalStackLayout>

        <!-- Modules and lectures (FR-L30), drawn as a timeline -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Modules}" IsGrouped="True" IsVisible="{Binding HasCourse}"
                        SelectionMode="None" Margin="16,0">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:ModuleGroup">
                    <Border Style="{StaticResource TintCard}" Margin="0,18,0,10" Padding="16,14">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" SemanticProperties.HeadingLevel="Level2" VerticalOptions="Center" />
                                <Border Grid.Column="1" Style="{StaticResource Pill}" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                                    <Label Text="{Binding State, Converter={StaticResource StateText}}" FontSize="12" FontAttributes="Bold"
                                           TextColor="{Binding State, Converter={StaticResource StateColor}}" />
                                </Border>
                            </Grid>
                            <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Objective}" Style="{StaticResource Caption}"
                                   IsVisible="{Binding Objective, Converter={StaticResource HasText}}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="learning:RoadmapLectureDto">
                    <Grid ColumnDefinitions="40,*" ColumnSpacing="10" Padding="0,0,0,10">
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding State, Converter={StaticResource StateLocked}}" Value="True">
                                <Setter Property="Opacity" Value="0.6" />
                            </DataTrigger>
                        </Grid.Triggers>
                        <!-- Timeline rail + node -->
                        <BoxView WidthRequest="2" HorizontalOptions="Center" Margin="0,0,0,-10"
                                 Color="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}" />
                        <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="2"
                                Stroke="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}"
                                BackgroundColor="{Binding State, Converter={StaticResource StateTint}}"
                                HorizontalOptions="Center" VerticalOptions="Start" Margin="0,14,0,0">
                            <Path Style="{StaticResource IconSmall}" Data="{Binding State, Converter={StaticResource StateIcon}}"
                                  Stroke="{Binding State, Converter={StaticResource StateColor}}" />
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RoadmapViewModel}}, Path=OpenLectureCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" />
                                    <Label Style="{StaticResource Caption}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding EstimatedMinutes, StringFormat='{0} min'}" />
                                                <Span Text="{l:Tr Planned}" />
                                                <Span Text="{Binding PlannedDate, StringFormat='{0:ddd d MMM}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <HorizontalStackLayout Spacing="6">
                                        <Border Style="{StaticResource PillAmber}" Padding="8,2" IsVisible="{Binding IsCore, Converter={StaticResource Not}}">
                                            <Label Text="{l:Tr Optional}" Style="{StaticResource PillTextAmber}" FontSize="11" />
                                        </Border>
                                        <Border Style="{StaticResource PillDanger}" Padding="8,2" IsVisible="{Binding IsOverdue}">
                                            <Label Text="{l:Tr Overdue}" Style="{StaticResource PillTextDanger}" FontSize="11" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding State, Converter={StaticResource StateText}}"
                                       TextColor="{Binding State, Converter={StaticResource StateColor}}" VerticalOptions="Center" FontSize="13" FontAttributes="Bold" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</pages:BasePage>
