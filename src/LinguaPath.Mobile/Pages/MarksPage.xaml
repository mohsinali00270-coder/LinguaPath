<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:LinguaPath.Mobile.Localization"
                xmlns:pages="clr-namespace:LinguaPath.Mobile.Pages"
                xmlns:vm="clr-namespace:LinguaPath.Mobile.Core.ViewModels;assembly=LinguaPath.Mobile.Core"
                x:Class="LinguaPath.Mobile.Pages.MarksPage"
                x:DataType="vm:MarksViewModel"
                Title="{l:Tr MyMarks2}">
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">
                <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                </Border>
                <Label Text="{Binding Marks.CourseTitle}" Style="{StaticResource Subtitle}" />

                <!-- Course grade (FR-L73, BR-05) -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="{Binding GradeText}" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}" />
                            <Label Text="{l:Tr CourseGrade}" Style="{StaticResource Subtitle}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="{Binding DailyText}" FontSize="26" FontAttributes="Bold" />
                            <Label Text="{l:Tr DailyQuizzes}" Style="{StaticResource Subtitle}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <VerticalStackLayout>
                            <Label Text="{Binding ExamText}" FontSize="26" FontAttributes="Bold" />
                            <Label Text="{l:Tr MonthlyExams}" Style="{StaticResource Subtitle}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                <Label Text="{Binding RuleText}" Style="{StaticResource Subtitle}" FontSize="12" />

                <!-- Score trend (FR-L71) -->
                <Label Text="{l:Tr ScoreTrend}" Style="{StaticResource SectionHeader}" IsVisible="{Binding HasMarks}" />
                <ScrollView Orientation="Horizontal" IsVisible="{Binding HasMarks}">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Trend}" Spacing="6" HeightRequest="150">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrendBar">
                                <VerticalStackLayout WidthRequest="30" VerticalOptions="End" Spacing="2">
                                    <Label Text="{Binding Percentage}" FontSize="10" HorizontalOptions="Center" />
                                    <BoxView HeightRequest="{Binding Height}" WidthRequest="18" CornerRadius="4" HorizontalOptions="Center"
                                             Color="{StaticResource Primary}">
                                        <BoxView.Triggers>
                                            <DataTrigger TargetType="BoxView" Binding="{Binding IsExam}" Value="True">
                                                <Setter Property="Color" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                        </BoxView.Triggers>
                                    </BoxView>
                                    <Label Text="{Binding Label}" FontSize="9" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
                <Label Text="{l:Tr BlueDailyQuizOrangeMonthlyExam}" FontSize="11" Style="{StaticResource Subtitle}" IsVisible="{Binding HasMarks}" />

                <!-- Skills (FR-L71) -->
                <Label Text="{l:Tr BySkill}" Style="{StaticResource SectionHeader}" IsVisible="{Binding HasMarks}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Skills}" Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SkillBar">
                            <Grid ColumnDefinitions="100,*,50" ColumnSpacing="8">
                                <Label Text="{Binding Name}" VerticalOptions="Center" />
                                <ProgressBar Grid.Column="1" Progress="{Binding Fraction}" ProgressColor="{StaticResource Primary}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding Text}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Every quiz and exam (FR-L70) -->
                <Label Text="{l:Tr AllResults}" Style="{StaticResource SectionHeader}" />
                <Label Text="{l:Tr YourDailyQuizzesAndExamsWill}" IsVisible="{Binding HasMarks, Converter={StaticResource Not}}" Style="{StaticResource Subtitle}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:MarkItem">
                            <Border Style="{StaticResource Card}" Padding="12,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MarksViewModel}}, Path=OpenCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                                        <Label Text="{Binding Date}" Style="{StaticResource Subtitle}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                        <Label Text="{Binding Score}" FontSize="18" FontAttributes="Bold" HorizontalOptions="End" />
                                        <Label Text="{Binding Badge}" FontSize="11" Style="{StaticResource Subtitle}" HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</pages:BasePage>
