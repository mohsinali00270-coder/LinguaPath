<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:LinguaPath.Mobile.Localization"
                xmlns:pages="clr-namespace:LinguaPath.Mobile.Pages"
                xmlns:controls="clr-namespace:LinguaPath.Mobile.Controls"
                xmlns:vm="clr-namespace:LinguaPath.Mobile.Core.ViewModels;assembly=LinguaPath.Mobile.Core"
                xmlns:progress="clr-namespace:LinguaPath.Shared.Contracts.Progress;assembly=LinguaPath.Shared"
                x:Class="LinguaPath.Mobile.Pages.PointsPage"
                x:DataType="vm:PointsViewModel"
                Title="{l:Tr PointsAndBadges}">
    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
        <CollectionView ItemsSource="{Binding History}" RemainingItemsThreshold="5" RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                        Margin="16,0">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="12" Padding="0,12">
                    <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                    </Border>

                    <!-- Wallet (FR-S01, FR-S06) -->
                    <Border Style="{StaticResource HeroCard}">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="8">
                                        <Path Style="{StaticResource IconOnHero}" Data="{StaticResource IconZap}" Fill="{StaticResource Gold}" Stroke="{StaticResource Gold}" WidthRequest="22" HeightRequest="22" />
                                        <Label Text="{Binding TotalText}" FontSize="36" FontAttributes="Bold" TextColor="White" />
                                    </HorizontalStackLayout>
                                    <Label Text="{l:Tr PointsAcrossAllYourLanguages}" Style="{StaticResource HeroText}" FontSize="13" />
                                </VerticalStackLayout>
                                <Grid Grid.Column="1" WidthRequest="88" HeightRequest="88">
                                    <controls:ProgressRing Progress="{Binding TierProgress}" Thickness="8" RingColor="{StaticResource Gold}" TrackColor="#33FFFFFF" />
                                    <Label Text="{Binding TierText}" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"
                                           HorizontalOptions="Center" VerticalOptions="Center" MaxLines="2" Margin="12,0" />
                                </Grid>
                            </Grid>
                            <Label Text="{Binding NextTierText}" Style="{StaticResource HeroText}" FontSize="12" />
                            <Border Style="{StaticResource PillOnHero}">
                                <Label Text="{Binding WeekText}" FontSize="13" FontAttributes="Bold" TextColor="White" />
                            </Border>
                            <Label Text="{Binding CapText}" Style="{StaticResource HeroText}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Streak (BR-09) -->
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Style="{StaticResource IconTileAmber}" WidthRequest="60" HeightRequest="56" StrokeShape="RoundRectangle 18">
                                <Label Text="{Binding StreakText}" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{l:Tr DayStreak}" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding StreakHint}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Per language (FR-S01) -->
                    <Label Text="{l:Tr ByLanguage}" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource CardFlat}" Padding="16,6">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Languages}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:LanguageRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="0,8">
                                        <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconGlobe}" />
                                        <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding Points}" Style="{StaticResource LinkText}" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Badges (FR-L111) -->
                    <Label Text="{l:Tr Badges}" Style="{StaticResource SectionHeader}" />
                    <FlexLayout BindableLayout.ItemsSource="{Binding Badges}" Wrap="Wrap" JustifyContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="progress:BadgeDto">
                                <Border Style="{StaticResource CardFlat}" WidthRequest="106" Margin="0,0,8,8" Padding="8,12">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Earned}" Value="False">
                                            <Setter Property="Opacity" Value="0.35" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="2">
                                        <Border Style="{StaticResource IconTileAmber}" WidthRequest="52" HeightRequest="52" StrokeShape="RoundRectangle 26" HorizontalOptions="Center" Margin="0,0,0,4">
                                            <Label Text="{Binding Icon}" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Label Text="{Binding Title}" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding Description}" FontSize="10" Style="{StaticResource Subtitle}" HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Button Text="{l:Tr Leaderboard2}" Style="{StaticResource GradientButton}" Command="{Binding OpenLeaderboardCommand}" />
                    <Border Style="{StaticResource CardFlat}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{l:Tr ShowMyNameOnLeaderboards}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ShowOnLeaderboard}" />
                        </Grid>
                    </Border>

                    <Label Text="{l:Tr History}" Style="{StaticResource SectionHeader}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Label Text="{l:Tr CompleteALectureOrADaily}" Style="{StaticResource Subtitle}"
                       HorizontalTextAlignment="Center" Margin="0,20" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryRow">
                    <Grid ColumnDefinitions="*,Auto" Padding="4,10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Title}" FontAttributes="Bold">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsRevoked}" Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding Detail}" Style="{StaticResource Subtitle}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding PointsText}" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsNegative}" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</pages:BasePage>
