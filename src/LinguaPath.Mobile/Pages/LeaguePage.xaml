<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:LinguaPath.Mobile.Localization"
                xmlns:pages="clr-namespace:LinguaPath.Mobile.Pages"
                xmlns:vm="clr-namespace:LinguaPath.Mobile.Core.ViewModels;assembly=LinguaPath.Mobile.Core"
                xmlns:comp="clr-namespace:LinguaPath.Shared.Contracts.Competitions;assembly=LinguaPath.Shared"
                x:Class="LinguaPath.Mobile.Pages.LeaguePage"
                x:DataType="vm:LeagueViewModel"
                Title="{l:Tr MyLeague2}">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16,8" RowSpacing="6">
        <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
        </Border>
        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <Label Text="{Binding Header}" Style="{StaticResource Title}" />
            <Label Text="{Binding Detail}" Style="{StaticResource Subtitle}" FontSize="13" />
            <Label Text="{Binding LastWeek}" FontSize="13" IsVisible="{Binding HasLastWeek}" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Members}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:LeagueRow">
                    <Grid ColumnDefinitions="36,*,Auto,30" ColumnSpacing="8" Padding="4,8">
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding IsMe}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryLightDark}}" />
                            </DataTrigger>
                        </Grid.Triggers>
                        <Label Text="{Binding RankText}" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding Name}" LineBreakMode="TailTruncation" />
                        <Label Grid.Column="2" Text="{Binding Points}" FontAttributes="Bold" />
                        <Label Grid.Column="3" Text="{Binding Zone}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</pages:BasePage>
