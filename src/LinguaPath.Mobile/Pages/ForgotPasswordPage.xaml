<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:LinguaPath.Mobile.Localization"
                xmlns:pages="clr-namespace:LinguaPath.Mobile.Pages"
                xmlns:vm="clr-namespace:LinguaPath.Mobile.Core.ViewModels;assembly=LinguaPath.Mobile.Core"
                x:Class="LinguaPath.Mobile.Pages.ForgotPasswordPage"
                x:DataType="vm:ForgotPasswordViewModel"
                Title="{l:Tr ForgotPassword}">
    <ScrollView>
        <VerticalStackLayout Padding="24,12,24,32" Spacing="16">
            <Border Style="{StaticResource IconTile}" WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 18">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconLock}" WidthRequest="26" HeightRequest="26" />
            </Border>
            <Label Text="{l:Tr ResetYourPassword}" Style="{StaticResource Title}" />
            <Label Text="{l:Tr EnterYourAccountEmailAndWe}" Style="{StaticResource Subtitle}" />

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <VerticalStackLayout>
                <Label Text="{l:Tr Email}" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBox}">
                    <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="{l:Tr YouExampleCom}" ReturnType="Send"
                           ReturnCommand="{Binding SendCodeCommand}" />
                </Border>
                <Label Text="{Binding Errors[Email]}" Style="{StaticResource FieldError}" />
            </VerticalStackLayout>

            <Button Text="{l:Tr SendCode}" Command="{Binding SendCodeCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</pages:BasePage>
