<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:LinguaPath.Mobile.Localization"
                xmlns:pages="clr-namespace:LinguaPath.Mobile.Pages"
                xmlns:vm="clr-namespace:LinguaPath.Mobile.Core.ViewModels;assembly=LinguaPath.Mobile.Core"
                xmlns:comp="clr-namespace:LinguaPath.Shared.Contracts.Competitions;assembly=LinguaPath.Shared"
                x:Class="LinguaPath.Mobile.Pages.TournamentsPage"
                x:DataType="vm:TournamentsViewModel"
                Title="{l:Tr Tournaments2}">
    <Grid RowDefinitions="Auto,*" Padding="16,8">
        <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
        </Border>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Tournaments}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="{l:Tr NoTournamentsScheduledRightNowCheck}" Style="{StaticResource Subtitle}" HorizontalTextAlignment="Center" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:TournamentRow">
                    <Border Style="{StaticResource Card}" Margin="0,4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TournamentsViewModel}}, Path=OpenCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Detail}" Style="{StaticResource Subtitle}" FontSize="12" />
                            <Label Text="{Binding When}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryTextDark}}" />
                            <Label Text="{Binding Prizes}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</pages:BasePage>
