<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:LinguaPath.Mobile.Localization"
                xmlns:pages="clr-namespace:LinguaPath.Mobile.Pages"
                xmlns:vm="clr-namespace:LinguaPath.Mobile.Core.ViewModels;assembly=LinguaPath.Mobile.Core"
                x:Class="LinguaPath.Mobile.Pages.ResetPasswordPage"
                x:DataType="vm:ResetPasswordViewModel"
                Title="{l:Tr NewPassword}">
    <ScrollView>
        <VerticalStackLayout Padding="24,12,24,32" Spacing="16">
            <Border Style="{StaticResource IconTile}" WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 18">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconShield}" WidthRequest="26" HeightRequest="26" />
            </Border>
            <Label Text="{l:Tr ChooseANewPassword}" Style="{StaticResource Title}" />
            <Label Style="{StaticResource Subtitle}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{l:Tr IfAnAccountExistsFor}" />
                        <Span Text="{Binding Email}" FontAttributes="Bold" />
                        <Span Text="{l:Tr WeSentItA6Digit}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <VerticalStackLayout>
                <Label Text="{l:Tr Code}" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBox}">
                    <Entry Text="{Binding Code}" Keyboard="Numeric" MaxLength="6" Placeholder="000000" />
                </Border>
                <Label Text="{Binding Errors[Code]}" Style="{StaticResource FieldError}" />
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="{l:Tr NewPassword}" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBox}">
                    <Entry Text="{Binding NewPassword}" IsPassword="True" />
                </Border>
                <Label Text="{Binding Errors[NewPassword]}" Style="{StaticResource FieldError}" />
            </VerticalStackLayout>

            <VerticalStackLayout>
                <Label Text="{l:Tr ConfirmNewPassword}" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBox}">
                    <Entry Text="{Binding ConfirmPassword}" IsPassword="True" ReturnType="Done" ReturnCommand="{Binding ResetCommand}" />
                </Border>
                <Label Text="{Binding Errors[ConfirmPassword]}" Style="{StaticResource FieldError}" />
            </VerticalStackLayout>

            <Button Text="{l:Tr ChangePassword}" Command="{Binding ResetCommand}" />
            <Button Text="{Binding ResendText}" Style="{StaticResource LinkButton}" Command="{Binding ResendCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</pages:BasePage>
