<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:l="clr-namespace:LinguaPath.Mobile.Localization"
                xmlns:pages="clr-namespace:LinguaPath.Mobile.Pages"
                xmlns:vm="clr-namespace:LinguaPath.Mobile.Core.ViewModels;assembly=LinguaPath.Mobile.Core"
                x:Class="LinguaPath.Mobile.Pages.NotificationsPage"
                x:DataType="vm:NotificationsViewModel"
                Title="{l:Tr Inbox_Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{l:Tr Inbox_MarkAllRead}" Command="{Binding MarkAllReadCommand}" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,Auto,*" Padding="16,8,16,0" RowSpacing="8">
        <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
        </Border>
        <Label Grid.Row="1" Text="{Binding UnreadText}" IsVisible="{Binding HasUnread}" Style="{StaticResource Subtitle}" FontSize="13" />
        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Items}" RemainingItemsThreshold="5" RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.EmptyView>
                    <Label Text="{l:Tr Inbox_Empty}" IsVisible="{Binding IsEmpty}" HorizontalTextAlignment="Center" Margin="0,40"
                           Style="{StaticResource Subtitle}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:NotificationItem">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="{l:Tr Inbox_Delete}" BackgroundColor="{StaticResource Danger}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=DeleteCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=OpenCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Label Text="{Binding Icon}" FontSize="24" VerticalOptions="Start" AutomationProperties.IsInAccessibleTree="False" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                                        <Label Text="{Binding Body}" Style="{StaticResource Subtitle}" FontSize="13" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="End">
                                        <Label Text="{Binding When}" Style="{StaticResource Subtitle}" FontSize="12" HorizontalOptions="End" />
                                        <Ellipse Fill="{StaticResource Primary}" WidthRequest="10" HeightRequest="10" HorizontalOptions="End"
                                                 IsVisible="{Binding IsUnread}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</pages:BasePage>
