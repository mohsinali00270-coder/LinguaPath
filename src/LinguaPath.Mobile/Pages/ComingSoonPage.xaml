<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:LinguaPath.Mobile.Localization"
             x:Class="LinguaPath.Mobile.Pages.ComingSoonPage"
             Shell.NavBarIsVisible="False">
    <VerticalStackLayout Padding="32" Spacing="12" VerticalOptions="Center">
        <Label Text="{l:Tr ComingSoon}" Style="{StaticResource Title}" HorizontalOptions="Center" />
        <Label Text="{l:Tr ThisPartOfLinguaPathIsBeing}"
               Style="{StaticResource Subtitle}" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentPage>
