<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:LinguaPath.Mobile.Localization"
                xmlns:pages="clr-namespace:LinguaPath.Mobile.Pages"
                xmlns:vm="clr-namespace:LinguaPath.Mobile.Core.ViewModels;assembly=LinguaPath.Mobile.Core"
                x:Class="LinguaPath.Mobile.Pages.WordsPage"
                x:DataType="vm:WordsViewModel"
                Title="{l:Tr MyWords2}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{l:Tr Add2}" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,*" Padding="16,8,16,0" RowSpacing="8">
        <VerticalStackLayout Spacing="8">
            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>
            <Label Text="{Binding SummaryText}" Style="{StaticResource Subtitle}" />
            <Button Text="{l:Tr ReviewDueWords}" Command="{Binding ReviewCommand}" IsVisible="{Binding CanReview}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Style="{StaticResource InputBox}">
                    <Entry Text="{Binding Search}" Placeholder="{l:Tr Search}" ReturnCommand="{Binding FindCommand}" />
                </Border>
                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <CheckBox IsChecked="{Binding DueOnly}" />
                    <Label Text="{l:Tr DueOnly}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Words}">
            <CollectionView.EmptyView>
                <Label Text="{l:Tr NoWordsYetTapAWord}" IsVisible="{Binding IsEmpty}"
                       Style="{StaticResource Subtitle}" HorizontalTextAlignment="Center" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:WordRow">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="{l:Tr Delete}" BackgroundColor="{StaticResource Danger}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WordsViewModel}}, Path=DeleteCommand}" CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Word}" FontAttributes="Bold" FontSize="17" />
                                    <Label Text="{Binding Meaning}" />
                                    <Label Text="{Binding Example}" Style="{StaticResource Subtitle}" FontSize="13" FontAttributes="Italic" IsVisible="{Binding HasExample}" />
                                    <Label Text="{Binding Due}" Style="{StaticResource Subtitle}" FontSize="11" />
                                </VerticalStackLayout>
                                <Button SemanticProperties.Description="{l:Tr ReadAloud}" Grid.Column="1" Text="🔊" Style="{StaticResource OutlineButton}" VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WordsViewModel}}, Path=SpeakCommand}" CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</pages:BasePage>
