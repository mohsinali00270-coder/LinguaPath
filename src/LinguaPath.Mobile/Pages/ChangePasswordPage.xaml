<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:LinguaPath.Mobile.Localization"
                xmlns:pages="clr-namespace:LinguaPath.Mobile.Pages"
                xmlns:vm="clr-namespace:LinguaPath.Mobile.Core.ViewModels;assembly=LinguaPath.Mobile.Core"
                x:Class="LinguaPath.Mobile.Pages.ChangePasswordPage"
                x:DataType="vm:ChangePasswordViewModel"
                Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>
            <Label Text="{l:Tr YouSignedUpWithGoogleOr}"
                   Style="{StaticResource Subtitle}" IsVisible="{Binding HasPassword, Converter={StaticResource Not}}" />

            <VerticalStackLayout IsVisible="{Binding HasPassword}">
                <Label Text="{l:Tr CurrentPassword}" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBox}"><Entry Text="{Binding CurrentPassword}" IsPassword="True" /></Border>
                <Label Text="{Binding Errors[CurrentPassword]}" Style="{StaticResource FieldError}" />
            </VerticalStackLayout>
            <VerticalStackLayout>
                <Label Text="{l:Tr NewPassword}" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBox}"><Entry Text="{Binding NewPassword}" IsPassword="True" /></Border>
                <Label Text="{Binding Errors[NewPassword]}" Style="{StaticResource FieldError}" />
            </VerticalStackLayout>
            <VerticalStackLayout>
                <Label Text="{l:Tr ConfirmNewPassword}" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBox}"><Entry Text="{Binding ConfirmPassword}" IsPassword="True" ReturnType="Done" ReturnCommand="{Binding SaveCommand}" /></Border>
                <Label Text="{Binding Errors[ConfirmPassword]}" Style="{StaticResource FieldError}" />
            </VerticalStackLayout>

            <Button Text="{l:Tr Save}" Command="{Binding SaveCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</pages:BasePage>
