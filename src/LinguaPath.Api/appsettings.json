  "Retention": {
    "Enabled": true,
    "PracticeRecordingDays": 30,
    "ReadNotificationDays": 90,
    "UnreadNotificationDays": 180,
    "DeletedAccountPurgeDays": 30,
    "ExpiredTokenDays": 30,
    "RunAtUtcHour": 2
