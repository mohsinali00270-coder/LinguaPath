{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=LinguaPath;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Database": {
    "Provider": "SqlServer",
    "SkipInitialization": false
  },
  "Jwt": {
    "Issuer": "LinguaPath",
    "Audience": "LinguaPath.Mobile",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Otp": {
    "Length": 6,
    "ExpiryMinutes": 10,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60
  },
  "App": {
    "Name": "LinguaPath",
    "PublicBaseUrl": "https://localhost:7080",
    "SupportEmail": "support@linguapath.app",
    "MobileCallbackScheme": "linguapath"
  },
  "ExternalAuth": {
    "GoogleClientIds": [],
    "AppleAudiences": [],
    "GoogleWeb": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Email": {
    "Mode": "Pickup",
    "FromName": "LinguaPath",
    "FromAddress": "no-reply@linguapath.app",
    "PickupDirectory": "App_Data/emails",
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "UserName": "",
    "Password": ""
  },
  "Storage": {
    "Provider": "Local",
    "LocalFolder": "uploads"
  },
  "Seed": {
    "SuperAdminEmail": "admin@linguapath.local",
    "SuperAdminPassword": "Admin@12345",
    "SuperAdminName": "Super Admin"
  },
  "RateLimiting": {
    "AuthPerMinute": 10,
    "GlobalPerMinute": 120
  },
  "Cors": {
    "Origins": []
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Using": [
      "Serilog.Sinks.Seq"
    ]
  },
  "Ai": {
    "ForceOffline": false,
    "OfflineWhenNoKey": false,
    "TimeoutSeconds": 120,
    "Providers": {
      "DeepSeek": {
        "BaseUrl": "https://api.deepseek.com",
        "ApiKey": ""
      },
      "OpenAI": {
        "BaseUrl": "https://api.openai.com/v1",
        "ApiKey": ""
      }
    },
    "Runner": {
      "Enabled": false,
      "PollSeconds": 10
    }
  },
  "AllowedHosts": "*",
  "LanguageServices": {
    "ForceOffline": false,
    "OfflineWhenNoKey": false,
    "TimeoutSeconds": 30,
    "Translator": {
      "Endpoint": "https://api.cognitive.microsofttranslator.com",
      "Region": "",
      "ApiKey": ""
    },
    "Speech": {
      "Region": "",
      "ApiKey": "",
      "Endpoint": ""
    }
  },
  "Push": {
    "FcmProjectId": "",
    "FcmServiceAccount": ""
  },
  "Competitions": {
    "CountdownSeconds": 5,
    "ResultPauseSeconds": 3,
    "GraceMilliseconds": 1500,
    "QuickMatchWaitSeconds": 30,
    "ChallengeExpiryHours": 24,
    "GroupBattleMinPlayers": 3,
    "GroupBattleMaxPlayers": 50,
    "TournamentBreakSeconds": 30
  },
  "Reminders": {
    "Enabled": true,
    "IntervalMinutes": 15,
    "StudyWindowMinutes": 60,
    "DefaultStudyTime": "19:00",
    "QuizReadyFrom": "17:00",
    "StreakAlertFrom": "20:00",
    "ExamAlertFrom": "09:00",
    "ExamDaysBefore": 3,
    "QuietFrom": "22:00",
    "QuietUntil": "08:00",
    "NewPostMaxAgeDays": 7
