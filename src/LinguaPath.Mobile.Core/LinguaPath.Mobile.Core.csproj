<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Platform-independent part of the MAUI app: API clients, session handling and ViewModels.
    Kept free of MAUI types so it compiles and is unit-tested on any OS.
    The MAUI head project (LinguaPath.Mobile) supplies the platform services through interfaces.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Refit" />
    <PackageReference Include="Refit.HttpClientFactory" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LinguaPath.Shared\LinguaPath.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LinguaPath.UnitTests" />
  </ItemGroup>
</Project>
