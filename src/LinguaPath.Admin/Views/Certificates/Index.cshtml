@model IReadOnlyList<CertificateListItem>
@{
    ViewData["Title"] = "Certificates";
    var revoked = ViewBag.Revoked as bool?;
    var page = (int)ViewBag.Page;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="small text-muted mb-0">Issued automatically when a learner meets the certificate rule (BR-06). <b>@ViewBag.ThisMonth</b> issued this month.</p>
    <a asp-controller="CertificateTemplates" asp-action="Index" class="btn btn-outline-primary btn-sm">Templates</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Number, name or email" /></div>
    <div class="col-md-3"><select name="languageId" class="form-select" asp-items="ViewBag.Languages"><option value="">All languages</option></select></div>
    <div class="col-md-3">
        <select name="revoked" class="form-select">
            <option value="">Valid and revoked</option>
            <option value="false" selected="@(revoked == false)">Valid only</option>
            <option value="true" selected="@(revoked == true)">Revoked only</option>
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-outline-primary w-100" type="submit">Filter</button></div>
</form>

<div class="card lp-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Number</th><th>Learner</th><th>Language · course</th><th>Level</th><th>Grade</th><th>Issued</th><th></th></tr></thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No certificates yet.</td></tr>
            }
            @foreach (var c in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@c.Id" class="font-monospace">@c.Number</a>
                        @if (c.IsRevoked) { <span class="badge text-bg-danger ms-1">revoked</span> }
                        @if (c.Version > 1) { <span class="badge text-bg-light border ms-1">v@(c.Version)</span> }
                    </td>
                    <td><a asp-controller="Learners" asp-action="Details" asp-route-id="@c.UserId">@c.LearnerName</a><div class="small text-muted">@c.Email</div></td>
                    <td>@c.Language<div class="small text-muted">@c.Course</div></td>
                    <td>@c.Level</td>
                    <td>@c.Grade% <span class="small text-muted">@c.Band</span></td>
                    <td>@c.IssuedAt.ToLocalTime().ToString("d MMM yyyy")</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Pdf" asp-route-id="@c.Id" target="_blank">PDF</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<div class="d-flex justify-content-between mt-2">
    @if (page > 1) { <a asp-route-page="@(page - 1)" asp-route-search="@ViewBag.Search" asp-route-languageId="@ViewBag.LanguageId" asp-route-revoked="@revoked">&larr; Newer</a> } else { <span></span> }
    @if (Model.Count == 100) { <a asp-route-page="@(page + 1)" asp-route-search="@ViewBag.Search" asp-route-languageId="@ViewBag.LanguageId" asp-route-revoked="@revoked">Older &rarr;</a> }
</div>
