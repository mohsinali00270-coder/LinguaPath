@model CertificateDetails
@{
    var c = Model.Summary;
    ViewData["Title"] = c.Number;
    var eligibility = ViewBag.Eligibility as LinguaPath.Shared.Contracts.Certificates.CertificateProgressDto;
}
<a asp-action="Index" class="small">&larr; Certificates</a>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2 mb-3">
    <h2 class="h5 mb-0 font-monospace">@c.Number
        @if (c.IsRevoked) { <span class="badge text-bg-danger">revoked</span> } else { <span class="badge text-bg-success">valid</span> }
    </h2>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary" asp-action="Pdf" asp-route-id="@c.Id" target="_blank">Open PDF</a>
        <a class="btn btn-sm btn-outline-secondary" href="@Model.VerifyUrl" target="_blank">Verification page</a>
        <form asp-action="Reissue" asp-route-id="@c.Id" method="post" data-confirm="Reissue with current grade, name and template? The number stays the same.">
            <button class="btn btn-sm btn-outline-primary">@(c.IsRevoked ? "Restore and reissue" : "Reissue")</button>
        </form>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card lp-card">
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-4">Learner</dt><dd class="col-sm-8"><a asp-controller="Learners" asp-action="Details" asp-route-id="@c.UserId">@c.LearnerName</a> · @c.Email</dd>
                    <dt class="col-sm-4">Language · course</dt><dd class="col-sm-8">@c.Language · @c.Course</dd>
                    <dt class="col-sm-4">Level achieved</dt><dd class="col-sm-8">@c.Level</dd>
                    <dt class="col-sm-4">Final grade</dt><dd class="col-sm-8">@c.Grade% (@c.Band)</dd>
                    <dt class="col-sm-4">Study period</dt><dd class="col-sm-8">@Model.StartedOn.ToString("d MMM yyyy") – @Model.CompletedOn.ToString("d MMM yyyy")</dd>
                    <dt class="col-sm-4">Issued</dt><dd class="col-sm-8">@c.IssuedAt.ToLocalTime().ToString("d MMM yyyy HH:mm") @if (Model.ReissuedAt is { } r) { <span>· reissued @r.ToLocalTime().ToString("d MMM yyyy") (v@(c.Version))</span> }</dd>
                    <dt class="col-sm-4">Verification code</dt><dd class="col-sm-8 font-monospace">@Model.VerificationCode</dd>
                    <dt class="col-sm-4">Template</dt><dd class="col-sm-8">@(Model.Template ?? "Default")</dd>
                    @if (c.IsRevoked)
                    {
                        <dt class="col-sm-4 text-danger">Revoked</dt>
                        <dd class="col-sm-8 text-danger">@Model.RevokedAt?.ToLocalTime().ToString("d MMM yyyy") by @Model.RevokedBy: @Model.RevokedReason</dd>
                    }
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        @if (eligibility is not null)
        {
            <div class="card lp-card mb-3">
                <div class="card-body">
                    <h3 class="h6">Certificate rule today</h3>
                    <partial name="_Checklist" model="eligibility" />
                </div>
            </div>
        }
        @if (!c.IsRevoked)
        {
            <div class="card lp-card border-danger">
                <div class="card-body">
                    <h3 class="h6 text-danger">Revoke</h3>
                    <form asp-action="Revoke" asp-route-id="@c.Id" method="post" data-confirm="Revoke this certificate? The public page will show it as revoked.">
                        <textarea name="reason" class="form-control form-control-sm mb-2" rows="2" placeholder="Reason (required, audited)" required minlength="3"></textarea>
                        <div class="form-check small mb-2">
                            <input class="form-check-input" type="checkbox" name="revokePoints" value="true" id="revokePoints" />
                            <label class="form-check-label" for="revokePoints">Also take back the certificate's points (e.g. for cheating)</label>
                        </div>
                        <button class="btn btn-sm btn-danger">Revoke certificate</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
