@model LinguaPath.Shared.Contracts.Certificates.CertificateProgressDto
@{
    ViewData["Title"] = "Certificate rule";
    var learnerId = ViewBag.LearnerId as Guid?;
}
@if (learnerId is { } id) { <a asp-controller="Learners" asp-action="Details" asp-route-id="@id" class="small">&larr; Learner</a> }
<div class="card lp-card mt-2" style="max-width:640px">
    <div class="card-body">
        <h2 class="h6">@Model.CourseTitle</h2>
        <partial name="_Checklist" model="Model" />
        <div class="mt-3">
            @if (Model.CertificateId is { } certId)
            {
                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@certId">Open certificate</a>
            }
            else if (Model.Eligible)
            {
                <form asp-action="Issue" method="post">
                    <input type="hidden" name="learnerCourseId" value="@Model.LearnerCourseId" />
                    <input type="hidden" name="learnerId" value="@learnerId" />
                    <button class="btn btn-sm btn-success">Issue the certificate now</button>
                </form>
                <p class="small text-muted mt-2 mb-0">Certificates are issued automatically after the last lecture or exam; use this if the rule changed since.</p>
            }
            else
            {
                <p class="small text-muted mb-0">Not eligible yet. The certificate is issued automatically as soon as every item is ticked.</p>
            }
        </div>
    </div>
</div>
