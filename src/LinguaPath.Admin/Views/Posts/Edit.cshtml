@model PostInput
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New post" : "Edit post";
    var state = ViewBag.State as (ContentStatus Status, ContentSource Source)?;
    var status = state?.Status ?? ContentStatus.Draft;
    var history = ViewBag.History as IReadOnlyList<ReviewHistoryItem> ?? [];
}
<a asp-action="Index" class="small">&larr; Posts</a>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2 mb-3">
    <h2 class="h5 mb-0">@(isNew ? "New post" : Model.Title) @if (!isNew) { <partial name="_ContentStatus" model="status" /> }</h2>
    @if (!isNew)
    {
        <div class="d-flex flex-wrap gap-2">
            @if (status == ContentStatus.Draft)
            {
                <form asp-action="Submit" asp-route-id="@Model.Id" method="post"><button class="btn btn-sm btn-primary">Send for review</button></form>
            }
            @if (status == ContentStatus.Approved)
            {
                <form asp-action="Publish" asp-route-id="@Model.Id" method="post"><button class="btn btn-sm btn-success">Publish</button></form>
            }
            @if (status == ContentStatus.Published)
            {
                <form asp-action="Unpublish" asp-route-id="@Model.Id" method="post"><button class="btn btn-sm btn-outline-warning">Unpublish</button></form>
            }
            @if (status != ContentStatus.Archived)
            {
                <form asp-action="Archive" asp-route-id="@Model.Id" method="post" data-confirm="Archive this post?"><button class="btn btn-sm btn-outline-secondary">Archive</button></form>
            }
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Delete this post?"><button class="btn btn-sm btn-outline-danger">Delete</button></form>
        </div>
    }
</div>

@{
    var lastRejected = history.FirstOrDefault();
}
@if (lastRejected is { Status: ReviewStatus.Rejected } && status == ContentStatus.Draft)
{
    <div class="alert alert-warning small"><b>Reviewer asked for changes:</b> @lastRejected.Comment</div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card lp-card">
            <div class="card-body">
                <form asp-action="Save" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LanguageId" class="form-label"></label>
                            <select asp-for="LanguageId" asp-items="ViewBag.Languages" class="form-select"><option value="0">Choose…</option></select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PostType" class="form-label"></label>
                            <select asp-for="PostType" asp-items="Html.GetEnumSelectList<PostType>()" class="form-select"></select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Level" class="form-label"></label>
                            <select asp-for="Level" asp-items="Html.GetEnumSelectList<CefrLevel>()" class="form-select"><option value="">All levels</option></select>
                        </div>
                        <div class="col-12"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div>
                        <div class="col-12"><label asp-for="Body" class="form-label"></label><textarea asp-for="Body" class="form-control" rows="6"></textarea><div class="form-text">Plain text. Line breaks are kept.</div></div>
                        <div class="col-md-6"><label asp-for="Url" class="form-label"></label><input asp-for="Url" class="form-control" placeholder="https://…" /></div>
                        <div class="col-md-6"><label asp-for="ImageUrl" class="form-label"></label><input asp-for="ImageUrl" class="form-control" placeholder="https://…" /></div>
                        <div class="col-md-6"><label asp-for="Tags" class="form-label"></label><input asp-for="Tags" class="form-control" /></div>
                        <div class="col-md-6">
                            <label asp-for="LectureId" class="form-label"></label>
                            <select asp-for="LectureId" asp-items="ViewBag.Lectures" class="form-select"><option value="">None</option></select>
                            <div class="form-text">Published lectures of the chosen language. Save once after picking a language to load them.</div>
                        </div>
                        <div class="col-md-6"><label asp-for="PublishAtUtc" class="form-label"></label><input asp-for="PublishAtUtc" type="datetime-local" class="form-control" /></div>
                        <div class="col-md-6 d-flex align-items-end"><div class="form-check"><input asp-for="IsPinned" class="form-check-input" /><label asp-for="IsPinned" class="form-check-label"></label></div></div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Save</button>
                        @if (status == ContentStatus.Draft)
                        {
                            <button type="submit" name="then" value="submit" class="btn btn-outline-primary">Save and send for review</button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card lp-card">
            <div class="card-body">
                <h3 class="h6">Review history</h3>
                @if (history.Count == 0) { <p class="small text-muted mb-0">Not reviewed yet.</p> }
                @foreach (var h in history)
                {
                    <div class="small mb-2">
                        <span class="badge text-bg-light border">@h.Status</span> @h.SubmittedAt.ToLocalTime().ToString("d MMM")
                        @if (h.Reviewer is not null) { <span>· @h.Reviewer</span> }
                        @if (!string.IsNullOrEmpty(h.Comment)) { <div class="text-muted">"@h.Comment"</div> }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
