@model CertificateTemplateInput
@{
    ViewData["Title"] = Model.Id == 0 ? "New certificate template" : "Edit certificate template";
}
<a asp-action="Index" class="small">&larr; Templates</a>
<div class="row g-3 mt-1">
    <div class="col-lg-8">
        <div class="card lp-card">
            <div class="card-body">
                <form asp-action="Save" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="LogoUrl" />
                    <input type="hidden" asp-for="SignatureUrl" />
                    <input type="hidden" asp-for="BackgroundUrl" />
                    <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
                    <div class="row g-3">
                        <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
                        <div class="col-md-6">
                            <label asp-for="LanguageId" class="form-label"></label>
                            <select asp-for="LanguageId" asp-items="ViewBag.Languages" class="form-select"><option value="">Default (all languages)</option></select>
                        </div>
                        <div class="col-md-8"><label asp-for="Heading" class="form-label"></label><input asp-for="Heading" class="form-control" /></div>
                        <div class="col-md-4"><label asp-for="AccentColor" class="form-label"></label><input asp-for="AccentColor" type="color" class="form-control form-control-color w-100" /></div>
                        <div class="col-12">
                            <label asp-for="BodyText" class="form-label"></label>
                            <textarea asp-for="BodyText" class="form-control" rows="4"></textarea>
                            <div class="form-text">Placeholders: {Name} {Language} {Course} {Level} {Grade} {Band} {Duration} {CompletedOn} {Number}</div>
                        </div>
                        <div class="col-md-6"><label asp-for="SignatoryName" class="form-label"></label><input asp-for="SignatoryName" class="form-control" /></div>
                        <div class="col-md-6"><label asp-for="SignatoryTitle" class="form-label"></label><input asp-for="SignatoryTitle" class="form-control" /></div>
                        @foreach (var (field, label, url, remove) in new[] { ("logo", "Logo", Model.LogoUrl, "removeLogo"), ("signature", "Signature image", Model.SignatureUrl, "removeSignature"), ("background", "Background (A4 landscape)", Model.BackgroundUrl, "removeBackground") })
                        {
                            <div class="col-md-4">
                                <label class="form-label">@label</label>
                                <input type="file" name="@field" accept="image/png,image/jpeg,image/webp" class="form-control form-control-sm" />
                                @if (!string.IsNullOrEmpty(url))
                                {
                                    <img src="@url" alt="" class="img-thumbnail mt-2" style="max-height:60px" />
                                    <div class="form-check small"><input type="checkbox" class="form-check-input" name="@remove" value="true" id="@remove" /><label class="form-check-label" for="@remove">Remove</label></div>
                                }
                            </div>
                        }
                        <div class="col-12 form-check ms-1"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <button type="submit" name="then" value="preview" formtarget="_blank" class="btn btn-outline-secondary">Preview PDF</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card lp-card"><div class="card-body small text-muted">
            The PDF is A4 landscape with a border in the accent colour, the logo at the top, the learner's name, your text, the language,
            level, grade and completion date, the signature at the bottom left and a QR code to the verification page at the bottom right.
            Images are PNG, JPEG or WebP up to 2 MB.
        </div></div>
    </div>
</div>
