@model List<string>
<div class="mb-3">
    <label class="form-label d-block">Roles</label>
    @foreach (var role in Roles.AdminRoles)
    {
        var id = "role-" + role;
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="Roles" value="@role" id="@id" checked="@(Model.Contains(role))" />
            <label class="form-check-label" for="@id"><b>@role</b> <span class="text-muted small">— @Roles.Describe(role)</span></label>
        </div>
    }
    @Html.ValidationMessage("Roles", null, new { @class = "text-danger small" })
</div>
