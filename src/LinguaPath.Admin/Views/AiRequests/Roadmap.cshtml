@model RoadmapAiInput
@{
    ViewData["Title"] = "Generate a roadmap with AI";
}
<a asp-action="Index" class="small">&larr; AI generation</a>
<div class="card lp-card mt-2" style="max-width:860px">
    <div class="card-body">
        <p class="small text-muted">AI proposes modules and lecture titles with objectives for a new Draft course (FR-A31). Edit it in the builder, then fill the lectures yourself or with AI.</p>
        <form asp-action="Roadmap" method="post">
            <partial name="_RoadmapFields" model="Model" />
            <div class="form-check mt-3">
                <input asp-for="GenerateContent" class="form-check-input" />
                <label asp-for="GenerateContent" class="form-check-label"></label>
            </div>
            <button class="btn btn-primary mt-3">Generate roadmap</button>
        </form>
    </div>
</div>
