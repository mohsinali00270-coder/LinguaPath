@model PracticeAiInput
@{
    ViewData["Title"] = "Draft practice exercises with AI";
}
<a asp-action="Index" class="small">&larr; Practice library</a>
<div class="card lp-card mt-2" style="max-width:760px">
    <div class="card-body">
        <p class="small text-muted">AI drafts exercises at one CEFR level. They are Drafts with the prompt attached until a reviewer approves them and you publish them (BR-13).</p>
        <form asp-action="Generate" method="post">
            <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
            <div class="row g-3">
                <div class="col-md-6"><label asp-for="LanguageId" class="form-label"></label><select asp-for="LanguageId" asp-items="ViewBag.Languages" class="form-select"><option value="0">Choose…</option></select></div>
                <div class="col-md-6">
                    <label asp-for="Type" class="form-label"></label>
                    <select asp-for="Type" class="form-select">
                        <option value="@PracticeType.Read">Reading passages with questions</option>
                        <option value="@PracticeType.Write">Writing tasks</option>
                        <option value="@PracticeType.Speak">Sentences to read aloud</option>
                        <option value="@PracticeType.Listen">Dictation sentences</option>
                    </select>
                </div>
                <div class="col-md-4"><label asp-for="Level" class="form-label"></label><select asp-for="Level" asp-items="Html.GetEnumSelectList<CefrLevel>()" class="form-select"></select></div>
                <div class="col-md-4"><label asp-for="Count" class="form-label"></label><input asp-for="Count" class="form-control" /></div>
                <div class="col-md-4"><label asp-for="Topic" class="form-label"></label><input asp-for="Topic" class="form-control" placeholder="everyday life" /></div>
                <div class="col-md-6"><label asp-for="NativeLanguage" class="form-label"></label><input asp-for="NativeLanguage" class="form-control" /></div>
                <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
            </div>
            <button class="btn btn-primary mt-3">Draft the exercises</button>
        </form>
    </div>
</div>
