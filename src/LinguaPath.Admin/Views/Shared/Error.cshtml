@{
    var code = (int)(ViewBag.Code ?? 500);
    ViewData["Title"] = code == 404 ? "Page not found" : code == 403 ? "No access" : "Something went wrong";
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_AuthLayout";
}
<div class="card lp-card">
    <div class="card-body text-center py-5">
        <div class="display-6 text-muted">@code</div>
        <p class="mt-3 mb-4">
            @(code == 404 ? "The page you asked for does not exist." :
              code == 403 ? "Your role does not have access to this page." :
              "An unexpected error happened. It has been logged.")
        </p>
        <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">Back to dashboard</a>
    </div>
</div>
