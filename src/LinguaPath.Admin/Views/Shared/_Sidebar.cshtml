<nav class="lp-nav">
    @foreach (var navGroup in visible.GroupBy(i => i.Section))
    {
        <div class="lp-nav-section">@navGroup.Key</div>
        @foreach (var item in navGroup)
        {
            var svg = $"<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"{IconFor(item)}\" /></svg>";
            if (item.Phase is null)
            {
                var active = IsActive(item);
                <a class="lp-nav-link @(active ? "active" : "")" aria-current="@(active ? "page" : null)"
                   asp-controller="@item.Controller" asp-action="@item.Action">@Html.Raw(svg)<span class="lp-nav-text">@item.Title</span></a>
            }
            else
            {
                <span class="lp-nav-link disabled" title="Arrives in phase @item.Phase">
                    @Html.Raw(svg)<span class="lp-nav-text">@item.Title</span> <span class="badge text-bg-light ms-1">P@(item.Phase)</span>
                </span>
            }
        }
    }
</nav>
