<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] · LinguaPath Admin</title>
    <partial name="_ThemeInit" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
@{
    var displayName = User.DisplayName();
    var initial = string.IsNullOrWhiteSpace(displayName) ? "?" : displayName.Trim()[..1].ToUpperInvariant();
}
<div class="lp-shell" id="lp-shell">
    <aside class="lp-sidebar" id="lp-sidebar" aria-label="Main navigation">
        <a class="lp-brand" asp-controller="Dashboard" asp-action="Index">
            <span class="lp-logo">L</span>
            <span>LinguaPath <small>Admin console</small></span>
        </a>
        <partial name="_Sidebar" />
    </aside>
    <div class="lp-backdrop" data-lp-nav-close></div>

    <div class="lp-main">
        <header class="lp-topbar">
            <div class="d-flex align-items-center gap-2 min-w-0">
                <button type="button" class="lp-icon-btn lp-menu-toggle" data-lp-nav-toggle aria-controls="lp-sidebar" aria-expanded="false" aria-label="Open menu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                </button>
                <h1 class="mb-0 text-truncate">@ViewData["Title"]</h1>
            </div>
            <div class="lp-topbar-actions">
                <button type="button" class="lp-icon-btn" data-lp-theme-toggle aria-label="Switch between light and dark theme" title="Switch theme">
                    <svg class="lp-theme-dark-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                    <svg class="lp-theme-light-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 1.5v2M12 20.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1.5 12h2M20.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" /></svg>
                </button>
                <div class="dropdown">
                    <button class="lp-user-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="lp-avatar" aria-hidden="true">@initial</span>
                        <span class="d-none d-sm-inline">@displayName</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li class="dropdown-item-text small text-muted">@User.Identity?.Name</li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Change password</a></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item">Sign out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="lp-content">
            <partial name="_StatusMessage" />
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
