@model IReadOnlyList<LanguageRequestGroup>
@{
    ViewData["Title"] = "Language requests";
    var current = ViewBag.Status as LanguageRequestStatus?;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted small mb-0">Languages learners asked for, most wanted first. Generating a new language with AI arrives in Phase 5.</p>
    <div class="btn-group btn-group-sm">
        <a class="btn @(current is null ? "btn-primary" : "btn-outline-primary")" asp-action="Index">All</a>
        @foreach (var s in Enum.GetValues<LanguageRequestStatus>())
        {
            <a class="btn @(current == s ? "btn-primary" : "btn-outline-primary")" asp-action="Index" asp-route-status="@s">@s</a>
        }
    </div>
</div>

<div class="card lp-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
            <tr><th>Language</th><th class="text-end">Requests</th><th class="text-end">Waiting</th><th>Status</th><th>First / last request</th><th></th></tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No requests.</td></tr>
            }
            @foreach (var r in Model)
            {
                <tr>
                    <td>
                        <b>@r.LanguageName</b>
                        @if (r.LanguageId is { } id)
                        {
                            <a class="small ms-1" asp-controller="Languages" asp-action="Edit" asp-route-id="@id">@(r.LanguageStatus == LanguageStatus.ComingSoon ? "Coming soon" : r.LanguageStatus?.ToString())</a>
                        }
                        else
                        {
                            <span class="small text-muted ms-1">not in the language list</span>
                        }
                    </td>
                    <td class="text-end">@r.Count</td>
                    <td class="text-end">@r.PendingCount</td>
                    <td><span class="badge text-bg-light border">@r.Status</span></td>
                    <td class="small text-muted">@r.FirstRequestedAt.ToLocalTime().ToString("d") – @r.LastRequestedAt.ToLocalTime().ToString("d")</td>
                    <td class="text-end">
                        <form asp-action="SetStatus" method="post" class="d-inline-flex gap-1">
                            <input type="hidden" name="name" value="@r.NormalizedName" />
                            <select name="status" class="form-select form-select-sm" style="width:auto">
                                @foreach (var s in Enum.GetValues<LanguageRequestStatus>())
                                {
                                    <option value="@s" selected="@(s == r.Status)">@s</option>
                                }
                            </select>
                            <button class="btn btn-sm btn-outline-secondary" type="submit">Set</button>
                        </form>
                        @if (r.LanguageId is null)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Languages" asp-action="Create">Add language</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
